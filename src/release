# build both targets locally
cargo build --release
cargo build --release --target x86_64-pc-windows-gnu

# tag a version
git tag v0.1.0
git push origin v0.1.0

# create the release and upload both binaries
gh release create v0.1.0 \
    target/release/tui-stundenplan \
    target/x86_64-pc-windows-gnu/release/tui-stundenplan.exe \
    --title "v0.1.0" \
    --notes "Initial release"
